PIX_NAME=
PIX_CITY=

# Stripe (cartão)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_METHODS=card
# 1 = libera parcelamento (só funciona em conta Stripe do Brasil)
STRIPE_PARCELAS=0
